        <mxCell id="dl3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=none;strokeColor=none;" value="pale yellow = heap allocated" vertex="1">
          <mxGeometry height="18" width="316" x="632" y="442" as="geometry" />
        </mxCell>
        <mxCell id="dl4" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=none;strokeColor=none;" value="hexagon = macro (preprocessor)" vertex="1">
          <mxGeometry height="18" width="316" x="632" y="464" as="geometry" />
        </mxCell>
        <mxCell id="dl5" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=none;strokeColor=none;" value="solid arrow = lookup / call" vertex="1">
          <mxGeometry height="18" width="316" x="632" y="486" as="geometry" />
        </mxCell>
        <mxCell id="dl6" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=none;strokeColor=none;" value="open diamond = heap ownership" vertex="1">
          <mxGeometry height="18" width="316" x="632" y="508" as="geometry" />
        </mxCell>
        <mxCell id="dl7" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=none;strokeColor=none;" value="green dotted = macro generates code" vertex="1">
          <mxGeometry height="18" width="316" x="632" y="530" as="geometry" />
        </mxCell>
        <mxCell id="dl8" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=none;strokeColor=none;" value="red box = invariant worth saying out loud" vertex="1">
          <mxGeometry height="18" width="316" x="632" y="552" as="geometry" />
        </mxCell>
        <mxCell id="inv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;Structural invariants&lt;/b&gt;&#xa;1. Owner injection: DECLARE_COMP_BEGIN puts &#39;Entity owner&#39; first, so a component finds its entity - and a system can mutate the very storage it iterates.&#xa;2. sparse_set[e] != -1  &lt;=&gt;  entity e owns that component; the two arrays stay one-to-one through dense_len.&#xa;3. dense_len &lt;= ENTITY_NUM_MAX (1024). Removal is swap-with-last: O(1), but it INVALIDATES pointers and reorders the dense array.&#xa;4. Query scans the SHORTEST candidate dense array among select + with, so cost is O(n) in that array, not O(entities x conditions).&#xa;5. The per-call-site offset cache is a function-local static (Q_FETCH): correct for one thread and one live QueryIter per call site.&#xa;&#xa;&lt;b&gt;Deliberate omissions&lt;/b&gt; (each is a trade, not an oversight): no archetype table, no entity generation counter, no change-detection tick, no asset handle." vertex="1">
          <mxGeometry height="206" width="340" x="620" y="596" as="geometry" />
        </mxCell>
        <mxCell id="de1" edge="1" parent="1" source="cnr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#4A7EBB;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" target="ctr" value="comp_id_fn(name)">
          <mxGeometry relative="1" x="0.2159" y="-10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="420" y="250" />
              <mxPoint x="305" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="de2" edge="1" parent="1" source="pool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.898;exitDx=0;exitDy=0;exitPerimeter=0;" target="ctr" value="Entity e">
          <mxGeometry relative="1" x="-0.5139" y="-14" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="305" y="206" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="de6" edge="1" parent="1" source="ctr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" target="qbox" value="CompType per condition">
          <mxGeometry relative="1" x="0.8182" y="65" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="de7" edge="1" parent="1" source="macro_query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=openThin;endFill=0;strokeColor=#2E9E6B;strokeWidth=2;dashed=1;dashPattern=6 3;fontSize=10;labelBackgroundColor=#FFFFFF;" target="qbox" value="fills conds[]">
          <mxGeometry relative="1" x="-0.026" y="-10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="145" y="550" />
              <mxPoint x="270" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="de8" edge="1" parent="1" source="ecmd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;entryX=0.867;entryY=-0.004;entryDx=0;entryDy=0;entryPerimeter=0;" target="ctr" value="insert / remove">
          <mxGeometry relative="1" x="-0.2941" y="10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="500" y="220" />
            </Array>
            <mxPoint x="500" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Time Sequence" id="ts1">
    <mxGraphModel dx="1213" dy="722" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2933;fillColor=none;strokeColor=none;" value="&lt;b&gt;MapleLeaf - Frame Pipeline &amp; Time Sequence&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="700" x="40" y="12" as="geometry" />
        </mxCell>
        <mxCell id="tsub" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#7B8794;fillColor=none;strokeColor=none;" value="One frame of MAIN_LOOP(fps): the exact order of systems and the three dispatch semantics." vertex="1">
          <mxGeometry height="16" width="900" x="40" y="38" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;1. Startup   [ONCE]&lt;/b&gt;&lt;br&gt;&lt;br&gt;The plugin list runs first: default_plugin, then the demo plugin. Each plugin only &lt;i&gt;registers&lt;/i&gt; - resources, components, systems into schedule slots. Then SCHEDULE_GLOBAL(Startup) runs once, e.g. demo1_ui_spawn builds the UI tree via cmd_spawn + ecmd_insert." vertex="1">
          <mxGeometry height="110" width="352" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;2. PreUpdate   [EVERY FRAME]&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. event_pumper: SDL_PollEvent, converts to render coordinates, writes Res_InputMouse via res_swap_update so the previous value survives as last_*.&#xa;2. message_buf_swapper: swaps next_messages / current_messages and clears next." vertex="1">
          <mxGeometry height="110" width="352" x="588" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;3. FixedUpdate   [CATCH-UP]&lt;/b&gt;&lt;br&gt;&lt;br&gt;while (now - last &gt; nspf) run the whole list, then last += nspf. Logic therefore steps at a fixed rate even when rendering is slow - but a long stall makes it run many times in one frame (spiral of death, currently unbounded)." vertex="1">
          <mxGeometry height="90" width="352" x="590" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;4. Update   [EVERY FRAME]&lt;/b&gt;&lt;br&gt;&lt;br&gt;User gameplay systems. They read global resources (get_delta_ms, get_fixed_ms, Res_InputMouse) and Query the component registry. Nothing here comes from the default plugin - this is where the demo lives." vertex="1">
          <mxGeometry height="90" width="352" x="200" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;5. PostUpdate   [EVERY FRAME]&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. node_computer - roots only, resolves Transform vs layout into ComputedNode.&#xa;2. btn_processor - hit test, derive BtnState, fire callback on release.&#xa;3. text_tiles_updater - rebuild glyph tiles when content_changed.&#xa;4. input_resources_syncer - copy current into last_* fields." vertex="1">
          <mxGeometry height="110" width="352" x="200" y="310" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;6. Render   [EVERY FRAME]&lt;/b&gt;&lt;br&gt;&lt;br&gt;render_start (clear) -&gt; render_ui (debug shading rects, then text tiles) -&gt; present. Draw order IS array order, which is exactly why render_* systems are registered last: PostUpdate has already produced every ComputedNode." vertex="1">
          <mxGeometry height="110" width="352" x="590" y="310" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;7. Frame tail&lt;/b&gt;&lt;br&gt;&lt;br&gt;elapsed = now - frame_start; if elapsed &lt; nspf then SDL_DelayPrecise(nspf - elapsed). The loop is frame-rate limited, not a spin loop. A 600-frame average is logged in Debug builds." vertex="1">
          <mxGeometry height="100" width="352" x="200" y="465" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F7F9FB;strokeColor=#8A94A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;8. Cleanup   [ONCE]&lt;/b&gt;&lt;br&gt;&lt;br&gt;Runs after the loop, when app-&gt;condition becomes false (SDL_EVENT_QUIT). APP_END then tears everything down: component registry, schedules, message queues, observers, timers, fonts, glyph textures, path cache." vertex="1">
          <mxGeometry height="100" width="352" x="590" y="465" as="geometry" />
        </mxCell>
        <mxCell id="phase_bar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F6EF;strokeColor=#2E9E6B;strokeWidth=2;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" value="Startup  |  PreUpdate  |  FixedUpdate  |  Update  |  PostUpdate  |  Render  |  frame tail  -&gt;  next frame" vertex="1">
          <mxGeometry height="30" width="1089" x="40" y="596" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDECEA;strokeColor=#C0392B;strokeWidth=2;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;The three dispatch semantics&lt;/b&gt;&#xa;SCHEDULE_GLOBAL(phase) - a function-local static bool makes the phase run exactly once, ever.&#xa;SCHEDULE_FRAME(phase) - run every system in array order, every iteration.&#xa;SCHEDULE_INTERVAL(phase) - catch up to wall time in fixed steps of Res_TimeFixed.nspf.&#xa;Cleanup is deliberately outside the loop: it is dispatched after condition becomes false.&#xa;&#xa;&lt;b&gt;Time, input and timers&lt;/b&gt;&#xa;Resources are plain static structs, so per-frame data is overwritten in place - except messages, which are double-buffered: a message sent in frame N is readable in frame N+1, and anything unread is dropped at the next swap, so no queue can grow without bound.&#xa;Res_InputMouse is double-written by res_swap_update (new value plus the old one into last_*), so a click is judged as &#39;released now, held before&#39; without an event queue.&#xa;Timer is deliberately synchronous - SDL&#39;s own timer fires on another thread, and game logic must stay on the main thread." vertex="1">
          <mxGeometry height="158" width="1089" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="te1" edge="1" parent="1" source="s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s2" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="115" />
              <mxPoint x="410" y="115" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="te2" edge="1" parent="1" source="s2" style="rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te3" edge="1" parent="1" source="s3" style="rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te4" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te5" edge="1" parent="1" source="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te6" edge="1" parent="1" source="s6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s7" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="766" y="440" />
              <mxPoint x="376" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="te7" edge="1" parent="1" source="s7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="s8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te8" edge="1" parent="1" source="s8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8A94A6;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" target="phase_bar" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="766" y="590" />
              <mxPoint x="766" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="te9" edge="1" parent="1" source="phase_bar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#C0392B;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" target="s1" value="condition == true">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="90" y="380" />
              <mxPoint x="90" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
